# Normalise to LF in the repository; Git checks out the platform's native
# endings. Without this, a Windows working copy warns on every staged file and
# the same file can differ between a local tree and the Ubuntu CI runner.
* text=auto eol=lf

# Binary assets Git must never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated; collapse it in diffs and reviews.
package-lock.json linguist-generated=true
